---
permalink: "/navigation/sequences/keep-second-modal/second.xml"
hv_title: "Second modal"
hv_button_behavior: "close"
---
{% extends 'templates/scrollview.xml.njk' %}
{% from 'macros/description/index.xml.njk' import description %}
{% from 'macros/button/index.xml.njk' import button %}

{% block content %}
  {{ description('Tap “Close first” to close “First modal” while keeping this modal open.') }}
  {{ description('Then tap “Close second” to return to “Keep second modal”.') }}
  {% call button('Close first') -%}
    <behavior
      action="dispatch-event"
      event-name="sequence-close-first-modal"
    />
  {%- endcall %}
  {% call button('Close second') -%}
    <behavior action="close" />
  {%- endcall %}
{% endblock %}
