---
permalink: "/navigation/sequences/keep-second-modal/index.xml"
tags: "Navigation/Scenarios"
hv_title: "Keep second modal"
hv_button_behavior: "back"
---
{% extends 'templates/scrollview.xml.njk' %}
{% from 'macros/description/index.xml.njk' import description %}
{% from 'macros/button/index.xml.njk' import button %}

{% block content %}
  <behavior
    trigger="on-event"
    event-name="sequence-open-second-modal"
    action="new"
    href="/hyperview/public/navigation/sequences/keep-second-modal/second.xml"
  />
  {{ description('Open “First modal”, then open “Second modal” above it.') }}
  {{ description('Close “First modal” from behind it. “Second modal” should stay open.') }}
  {% call button('Open first') -%}
    <behavior
      action="new"
      href="/hyperview/public/navigation/sequences/keep-second-modal/first.xml"
    />
  {%- endcall %}
{% endblock %}
