---
permalink: "/navigation/sequences/guarded-native-back/guarded.xml"
hv_title: "Guarded screen"
hv_button_behavior: "back"
---
{% extends 'templates/scrollview.xml.njk' %}
{% from 'macros/description/index.xml.njk' import description %}
{% from 'macros/button/index.xml.njk' import button %}
{% from 'macros/container/index.xml.njk' import container %}

{% block content %}
  {{ description('Use “Go back”, the header back button, or your platform’s system back control.') }}
  {{ description('The first attempt removes the guard without leaving “Guarded screen”. The second returns to “Back guard”.') }}
  {{ description('After the guard is removed, the next back attempt should complete normally. Interactive back gestures should track the gesture without snapping back.') }}
  {% call container('Back guard active. The first back attempt removes this notice.', attributes={id:"sequence-native-back-guard"}) -%}
    <behavior
      trigger="back"
      action="hide"
      target="sequence-native-back-guard"
    />
  {%- endcall %}
  {% call button('Go back') -%}
    <behavior action="back" />
  {%- endcall %}
{% endblock %}
