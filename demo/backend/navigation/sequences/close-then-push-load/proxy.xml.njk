{% extends 'templates/scrollview.xml.njk' %}
{% from 'macros/description/index.xml.njk' import description %}

{% block content %}
  {{ description('The temporary “Redirecting” route closes itself and pushes “Destination” during the same load event.') }}
  {{ description('This screen should never become visible.') }}
  <behavior trigger="load" action="close" once="true" />
  <behavior
    trigger="load"
    action="push"
    href="/hyperview/public/navigation/sequences/close-then-push-load/destination.xml"
    once="true"
  />
{% endblock %}
