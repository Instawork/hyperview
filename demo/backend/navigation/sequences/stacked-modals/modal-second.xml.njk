---
permalink: "/navigation/sequences/stacked-modals/modal-second.xml"
hv_title: "Stacked modals (modal 2)"
hv_button_behavior: "close"
---
{% extends 'templates/scrollview.xml.njk' %}
{% from 'macros/description/index.xml.njk' import description %}
{% from 'macros/button/index.xml.njk' import button %}

{% block content %}
  <behavior trigger="on-event" event-name="sequence-close-modal-flow" action="close" />
  {{ description('Open third modal on top.') }}
  {% call button('Open third modal') -%}
    <behavior
      action="new"
      href="/hyperview/public/navigation/sequences/stacked-modals/modal-third.xml"
      show-during-load="loading-screen-modal"
    />
  {%- endcall %}
{% endblock %}
