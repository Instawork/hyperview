{% macro home_icon(color) -%}
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path
      d="M3 10.5L12 3L21 10.5V21H15V15H9V21H3V10.5Z"
      stroke="{{ color }}"
      stroke-width="2"
      stroke-linejoin="round"
    />
  </svg>
{%- endmacro %}
{% macro message_icon(color) -%}
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path
      d="M5 19L3 21V7C3 4.79086 4.79086 3 7 3H17C19.2091 3 21 4.79086 21 7V15C21 17.2091 19.2091 19 17 19H5Z"
      stroke="{{ color }}"
      stroke-width="2"
      stroke-linejoin="round"
    />
  </svg>
{%- endmacro %}
{% from 'macros/tabbar-bottom/index.xml.njk' import tabbar_bottom %}
{% macro home_messages_tab_bar(navigator, home_route, messages_route) -%}
  {% call tabbar_bottom(navigator) -%}
    <navigation:bottom-tab-bar-item
      navigation:route="{{ home_route }}"
      navigation:label="Home"
      navigation:icon="house"
      style="sequence-bottom-tab"
    >
      <view style="sequence-bottom-tab-content">
        <view style="sequence-bottom-tab-icon-selected">
          {{ home_icon('#4778FF') }}
        </view>
        <view style="sequence-bottom-tab-icon">
          {{ home_icon('#8D9494') }}
        </view>
        <text style="sequence-bottom-tab-label">Home</text>
      </view>
    </navigation:bottom-tab-bar-item>
    <navigation:bottom-tab-bar-item
      navigation:route="{{ messages_route }}"
      navigation:label="Messages"
      navigation:icon="message"
      style="sequence-bottom-tab"
    >
      <view style="sequence-bottom-tab-content">
        <view style="sequence-bottom-tab-icon-selected">
          {{ message_icon('#4778FF') }}
        </view>
        <view style="sequence-bottom-tab-icon">
          {{ message_icon('#8D9494') }}
        </view>
        <text style="sequence-bottom-tab-label">Messages</text>
      </view>
    </navigation:bottom-tab-bar-item>
  {%- endcall %}
{%- endmacro %}
{{ home_messages_tab_bar("sequence-welcome-tabs-navigator", "sequence-home-route", "sequence-messages-route") }}
