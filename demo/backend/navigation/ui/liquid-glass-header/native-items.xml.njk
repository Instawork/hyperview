---
permalink: "/navigation/ui/liquid-glass-header/native-items.xml"
tags: "Navigation/UI/Header controls"
hv_title: "Header controls and menu"
hv_button_behavior: "back"
---
{% extends 'templates/scroll-base.xml.njk' %}
{% from 'macros/description/index.xml.njk' import description %}
{% from 'macros/navigation-header/index.xml.njk' import navigation_header %}

{% block styles %}
  <style id="native-header" marginBottom="0" />
  <style id="native-header-overlay" zIndex="10" />
  <style id="native-header-actions" alignItems="center" flexDirection="row" />
  <style id="native-header-action" marginLeft="12" />
  <style
    id="native-header-icon-button"
    alignItems="center"
    height="32"
    justifyContent="center"
    width="32"
  />
  <style
    id="native-header-badge"
    alignItems="center"
    backgroundColor="#FF383C"
    borderRadius="8"
    height="16"
    justifyContent="center"
    position="absolute"
    right="-3"
    top="-3"
    width="16"
  />
  <style
    id="native-header-badge-text"
    color="#FFFFFF"
    fontSize="10"
    fontWeight="700"
  />
  <style
    id="native-header-done-button"
    alignItems="center"
    backgroundColor="#0A84FF"
    borderRadius="16"
    height="32"
    justifyContent="center"
    paddingHorizontal="16"
  />
  <style id="native-header-done-text" color="#FFFFFF" />
  <style id="native-header-menu-items" display="none" />
  <style
    id="native-header-dismiss-layer"
    bottom="0"
    left="0"
    position="absolute"
    right="0"
    top="0"
    zIndex="9"
  />
  <style
    id="native-header-legacy-menu"
    backgroundColor="#FFFFFF"
    borderColor="#D1D1D6"
    borderRadius="12"
    borderWidth="1"
    position="absolute"
    right="16"
    top="48"
    width="180"
    zIndex="20"
  />
  <style
    id="native-header-legacy-menu-item"
    borderColor="#E5E5EA"
    borderTopWidth="1"
    paddingHorizontal="12"
    paddingVertical="14"
  />
  <style id="native-header-legacy-menu-label" color="#007AFF" />
  <style id="native-header-title" flex="1" />
  <style id="native-header-content" flex="1" paddingHorizontal="16" />
{% endblock %}

{% block header %}
  {% call navigation_header(hv_title, 'native-header', 'header-background native-header-overlay') %}
    <view
      action="back"
      href="#"
      id="native-header/header/back-button"
      style="header-btn"
      navigation:role="back"
    >
      {% include 'icons/back.svg' %}
    </view>
    <text numberOfLines="1" style="header-title native-header-title">
      {{ hv_title }}
    </text>
    <view style="native-header-actions">
      <view
        id="native-header/header/notifications-button"
        style="native-header-action native-header-icon-button"
        navigation:accessibility-label="Notifications"
        navigation:badge="7"
        navigation:icon="bell"
        navigation:role="right-item"
      >
        {% include 'icons/bell.svg' %}
        <view style="native-header-badge">
          <text style="native-header-badge-text">7</text>
        </view>
        <behavior
          xmlns:alert="https://hyperview.org/hyperview-alert"
          action="alert"
          alert:message="Notifications tapped."
          alert:title="Notifications"
        >
          <alert:option alert:label="OK" />
        </behavior>
      </view>
      <view
        id="native-header/header/done-button"
        style="native-header-action native-header-done-button"
        navigation:label="Done"
        navigation:role="right-item"
        navigation:item-background="separate"
        navigation:header-item-variant="done"
      >
        <text style="native-header-done-text">Done</text>
        <behavior
          xmlns:alert="https://hyperview.org/hyperview-alert"
          action="alert"
          alert:message="Done tapped."
          alert:title="Done"
        >
          <alert:option alert:label="OK" />
        </behavior>
      </view>
      <view
        id="native-header/header/menu"
        style="native-header-action native-header-icon-button"
        navigation:accessibility-label="More actions"
        navigation:icon="ellipsis.circle"
        navigation:role="right-item"
      >
        {% include 'icons/ellipsis-circle.svg' %}
        <view
          id="native-header/header/menu/refresh"
          style="native-header-menu-items"
          navigation:icon="arrow.clockwise"
          navigation:label="Refresh"
        >
          <behavior
            xmlns:alert="https://hyperview.org/hyperview-alert"
            action="alert"
            alert:message="Refresh selected."
            alert:title="Menu"
          >
            <alert:option alert:label="OK" />
          </behavior>
        </view>
        <view
          id="native-header/header/menu/remove"
          style="native-header-menu-items"
          navigation:icon="trash"
          navigation:label="Remove"
        >
          <behavior
            xmlns:alert="https://hyperview.org/hyperview-alert"
            action="alert"
            alert:message="Remove selected."
            alert:title="Menu"
          >
            <alert:option alert:label="OK" />
          </behavior>
        </view>
        <behavior
          action="toggle"
          target="native-header/header/legacy-menu"
          trigger="press"
        />
        <behavior
          action="toggle"
          target="native-header/content/dismiss-layer"
          trigger="press"
        />
      </view>
    </view>
    <view
      hide="true"
      id="native-header/header/legacy-menu"
      style="native-header-legacy-menu"
    >
      <view style="native-header-legacy-menu-item">
        <text style="native-header-legacy-menu-label">Refresh</text>
        <behavior
          xmlns:alert="https://hyperview.org/hyperview-alert"
          action="alert"
          alert:message="Refresh selected."
          alert:title="Menu"
          trigger="press"
        >
          <alert:option alert:label="OK">
            <behavior
              action="hide"
              target="native-header/header/legacy-menu"
            />
            <behavior
              action="hide"
              target="native-header/content/dismiss-layer"
            />
          </alert:option>
        </behavior>
      </view>
      <view style="native-header-legacy-menu-item">
        <text style="native-header-legacy-menu-label">Remove</text>
        <behavior
          xmlns:alert="https://hyperview.org/hyperview-alert"
          action="alert"
          alert:message="Remove selected."
          alert:title="Menu"
          trigger="press"
        >
          <alert:option alert:label="OK">
            <behavior
              action="hide"
              target="native-header/header/legacy-menu"
            />
            <behavior
              action="hide"
              target="native-header/content/dismiss-layer"
            />
          </alert:option>
        </behavior>
      </view>
    </view>
  {% endcall %}
{% endblock %}

{% block container %}
  <view
    hide="true"
    id="native-header/content/dismiss-layer"
    style="native-header-dismiss-layer"
  >
    <behavior
      action="hide"
      target="native-header/header/legacy-menu"
      trigger="press"
    />
    <behavior
      action="hide"
      target="native-header/content/dismiss-layer"
      trigger="press"
    />
  </view>
  <view scroll="true" style="native-header-content">
    {{ description('Badge, Done button, and overflow menu.') }}
    {{ description('Done uses its own glass so it does not blend into neighboring controls.') }}
    {{ description('The standard … menu offers the same Refresh and Remove actions. Tap outside to dismiss it.') }}
  </view>
{% endblock %}
