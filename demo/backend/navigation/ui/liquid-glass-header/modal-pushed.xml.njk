---
permalink: "/navigation/ui/liquid-glass-header/modal-pushed.xml"
hv_title: "Pushed screen"
hv_button_behavior: "back"
---
{% extends 'templates/scroll-base.xml.njk' %}
{% from 'macros/description/index.xml.njk' import description %}
{% from 'macros/navigation-header/index.xml.njk' import navigation_header %}

{% block styles %}
  <style id="liquid-header" marginBottom="0" />
  <style
    id="first-modal-push-image"
    height="280"
    marginBottom="16"
    resizeMode="cover"
    width="100%"
  />
  <style
    id="first-modal-push-actions"
    alignItems="center"
    columnGap="12"
    flexDirection="row"
  />
  <style
    id="first-modal-push-custom-item"
    alignItems="center"
    height="32"
    justifyContent="center"
    width="32"
  />
  <style
    id="first-modal-push-custom-dot"
    backgroundColor="#F5B700"
    borderRadius="8"
    height="16"
    width="16"
  />
  <style id="first-modal-push-title" flex="1" />
  <style id="first-modal-push-content" flex="1" />
{% endblock %}

{% block header %}
  {% call navigation_header(hv_title, 'liquid-header') %}
    <view
      action="back"
      href="#"
      id="liquid-header-push-1/header/back-button"
      style="header-btn"
      navigation:role="back"
    >
      {% include 'icons/back.svg' %}
    </view>
    <text numberOfLines="1" style="header-title first-modal-push-title">
      {{ hv_title }}
    </text>
    <view style="first-modal-push-actions">
      <view
        id="liquid-transition/header/persistent-help"
        navigation:icon="questionmark.circle"
        navigation:role="right-item"
      >
        {% include 'icons/help.svg' %}
        <behavior
          xmlns:alert="https://hyperview.org/hyperview-alert"
          action="alert"
          alert:message="Help tapped."
          alert:title="{{ hv_title }}"
        >
          <alert:option alert:label="OK" />
        </behavior>
      </view>
      <view
        id="liquid-transition/header/persistent-custom"
        style="first-modal-push-custom-item"
        navigation:role="right-item"
      >
        <view style="first-modal-push-custom-dot" />
        <behavior
          xmlns:alert="https://hyperview.org/hyperview-alert"
          action="alert"
          alert:message="Custom items do not use transition matching."
          alert:title="Custom transition item"
          trigger="press"
        >
          <alert:option alert:label="OK" />
        </behavior>
      </view>
    </view>
  {% endcall %}
{% endblock %}

{% block container %}
  <view scroll="true" style="first-modal-push-content">
    {{ description('This screen was pushed inside the first modal. Back returns to “Modal and push transitions”.') }}
    {{ description('The Help button moves between screens. The custom yellow item updates without a matched transition.') }}
    <image
      source="/hyperview/public/ui/ui-elements/image/image.jpg"
      style="first-modal-push-image"
    />
    {{ description('Close dismisses the first modal and returns to the parent screen.') }}
    <view action="close" href="#" style="button">
      <text style="button-label">Close modal</text>
    </view>
  </view>
{% endblock %}
