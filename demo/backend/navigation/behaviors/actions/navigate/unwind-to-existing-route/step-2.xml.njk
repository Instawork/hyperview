---
permalink: "/navigation/behaviors/actions/navigate/unwind-to-existing-route/step-2.xml"
hv_title: "Step 2"
hv_button_behavior: "back"
---
{% extends 'templates/scrollview.xml.njk' %}
{% from 'macros/description/index.xml.njk' import description %}
{% from 'macros/button/index.xml.njk' import button %}

{% block content %}
  {{ description('Stack: Step 1 → Step 2.') }}

  {{ description('Add Step 3 to the stack.') }}
  {% call button('Go to Step 3') -%}
    <behavior action="navigate" href="/hyperview/public/navigation/behaviors/actions/navigate/unwind-to-existing-route/step-3.xml" />
  {%- endcall %}

  {{ description('Return to the existing Step 1 and remove Step 2.') }}
  {% call button('Unwind to Step 1') -%}
    <behavior action="navigate" href="/hyperview/public/navigation/behaviors/actions/navigate/unwind-to-existing-route/index.xml" />
  {%- endcall %}
{% endblock %}
