{% from 'macros/navigation-header/index.xml.njk' import navigation_header %}

{% call navigation_header(hv_title) %}
  {% if hv_button_behavior == 'close' %}
    <view
      action="close"
      href="#"
      id="header/close-button"
      style="header-btn"
      navigation:role="close"
    >
      {% include 'icons/close.svg' %}
    </view>
  {% elif hv_button_behavior == 'back' %}
    <view
      action="back"
      href="#"
      id="header/back-button"
      style="header-btn"
      navigation:role="back"
    >
      {% include 'icons/back.svg' %}
    </view>
  {% endif %}
  <text style="header-title">{{ hv_title }}</text>
{% endcall %}
