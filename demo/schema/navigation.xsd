<xs:schema
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  attributeFormDefault="qualified"
  elementFormDefault="qualified"
  targetNamespace="https://hyperview.org/navigation"
  xmlns:nav="https://hyperview.org/navigation"
  xmlns:hv="https://hyperview.org/hyperview"
>
  <xs:import
    namespace="https://hyperview.org/hyperview"
    schemaLocation="hyperview.xsd"
  />
  <xs:element name="bottom-tab-bar">
    <xs:complexType>
      <xs:sequence>
        <xs:any minOccurs="0" maxOccurs="unbounded" />
      </xs:sequence>
      <xs:attribute name="id" type="hv:ID" form="unqualified" />
      <xs:attribute name="navigator" type="xs:string" />
    </xs:complexType>
  </xs:element>
  <xs:element name="bottom-tab-bar-item">
    <xs:complexType>
      <xs:sequence>
        <xs:any minOccurs="0" maxOccurs="unbounded" />
      </xs:sequence>
      <xs:attribute name="route" type="xs:string" use="required" />
      <xs:attribute name="style" type="hv:styleList" form="unqualified" />
      <xs:attribute name="key" type="hv:KEY" form="unqualified" />
      <xs:attribute name="label" type="xs:string" />
      <xs:attribute name="icon" type="xs:string" />
      <xs:attribute name="badge" type="xs:string" />
    </xs:complexType>
  </xs:element>
  <xs:simpleType name="role">
    <xs:restriction base="xs:string">
      <xs:enumeration value="back" />
      <xs:enumeration value="close" />
      <xs:enumeration value="right-item" />
      <xs:enumeration value="title" />
      <xs:enumeration value="left-item" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="titleMode">
    <xs:restriction base="xs:string">
      <xs:enumeration value="compact" />
      <xs:enumeration value="large" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="headerItemVariant">
    <xs:restriction base="xs:string">
      <xs:enumeration value="done" />
      <xs:enumeration value="plain" />
      <xs:enumeration value="prominent" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="itemBackground">
    <xs:restriction base="xs:string">
      <xs:enumeration value="none" />
      <xs:enumeration value="separate" />
      <xs:enumeration value="shared" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="searchPlacement">
    <xs:restriction base="xs:string">
      <xs:enumeration value="automatic" />
      <xs:enumeration value="integrated" />
      <xs:enumeration value="integratedButton" />
      <xs:enumeration value="integratedCentered" />
      <xs:enumeration value="stacked" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="back">
    <xs:complexType>
      <xs:sequence>
        <xs:any minOccurs="0" maxOccurs="unbounded" />
      </xs:sequence>
      <xs:attribute name="role" type="nav:role" />
    </xs:complexType>
  </xs:element>
  <xs:attributeGroup name="navAttributes">
    <xs:attribute name="accessibility-label" type="xs:string" />
    <xs:attribute name="badge" type="xs:string" />
    <xs:attribute name="item-background" type="nav:itemBackground" />
    <xs:attribute name="icon" type="xs:string" />
    <xs:attribute name="label" type="xs:string" />
    <xs:attribute name="role" type="nav:role" />
    <xs:attribute name="search-placeholder" type="xs:string" />
    <xs:attribute name="search-placement" type="nav:searchPlacement" />
    <xs:attribute name="search-target" type="hv:IDREF" />
    <xs:attribute name="title" type="xs:string" />
    <xs:attribute name="title-mode" type="nav:titleMode" />
    <xs:attribute name="header-item-variant" type="nav:headerItemVariant" />
  </xs:attributeGroup>
</xs:schema>
